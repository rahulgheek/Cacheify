# Cacheify backend (Cacheify API) configuration.
# Copy this file to `.env` (same folder as backend/package.json) and fill in
# real values. Only Two variables are validated at boot: MONGODB_URI is always
# required; JWT_SECRET is required in production (>= 32 characters).
# Never put real secrets into this file or commit it.

# ---------------------------------------------------------------- runtime ---
# production | development. In production the JWT_SECRET check below applies.
NODE_ENV=development

# Port the API listens on (panel-assigned; the process is plain HTTP - TLS is
# terminated by your proxy). SERVER_PORT is accepted as an alias.
# Sample value: a Pterodactyl-style panel assigns the app port.
PORT=3000
#SERVER_PORT=3000

# 0.0.0.0 is mandatory behind a TCP proxy/panel (loopback bind causes 503s).
HOST=0.0.0.0

# ------------------------------------------------------------- required ----
# Metadata store: users, databases, API keys, audit trails. ALWAYS required.
MONGODB_URI=<mongodb connection string>

# Auth token signing secret. REQUIRED in production, >= 32 characters.
JWT_SECRET=<random string at least 32 characters>

# ------------------------------------------------------------- optional ----
# Session lifetime in minutes (default 720 = 12 hours).
JWT_TTL_MINUTES=720

# Bootstrap admin account (seeded on first boot if set).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Comma-separated allowed browser origins for CORS. Empty = same-origin only.
CORS_ORIGINS=

# ------------------------------------------------- data plane (backend) ----
# Real Redis server for the data plane. Absent/empty = embedded engine on
# MongoDB collections (development). Supported: host:port, redis://, rediss://.
# Never expose this value to consumers; it stays server-side.
REDIS_CONNECTION_STRING=

# Namespace prefix stamped on every key written through the data plane.
REDIS_KEY_PREFIX=rh:

# PEM CA bundle for rediss:// connections (e.g. backend/.config/ca.pem).
REDIS_TLS_CA_FILE=

# Mandatory default TTL for every write (no-immortal-keys policy).
DEFAULT_KEY_TTL_MS=86400000

# ------------------------------------------------------------- quotas ------
QUOTA_MAX_DATABASES=5
QUOTA_MAX_KEYS_PER_DB=10000
# Max value size per key (512 KiB default).
QUOTA_MAX_VALUE_BYTES=524288

# --------------------------------------------------------- rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_PUBLIC=30
RATE_LIMIT_MAX_AUTHENTICATED=240
# Quota counters shorten their own TTL by this much (ms).
QUOTA_COUNT_TTL_MS=30000

# --------------------------------------------------------- data-plane ops --
# Per-database concurrent command cap (429 + Retry-After beyond it).
MAX_INFLIGHT_PER_DB=24

# --------------------------------------------------------- OAuth / OTP -----
# OTP login lifetime, resend cooldown, max wrong-code attempts.
OTP_TTL_MS=600000
OTP_RESEND_COOLDOWN_MS=60000
OTP_MAX_ATTEMPTS=5

# --------------------------------------------------------- email (SMTP) ----
# Preferred: Brevo HTTP API sends (takes priority when BREVO_API_KEY is set).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Cacheify
# Fallback: classic SMTP transport via nodemailer.
MAIL_HOST=
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# --------------------------------------------------------- HTTP surface ----
# JSON body size cap (256 KiB default).
BODY_LIMIT_BYTES=262144

# Password hashing cost for register flows.
BCRYPT_COST=10

# Embedded engine TTL sweeper interval (ms; local mode only).
SWEEP_INTERVAL_MS=60000
