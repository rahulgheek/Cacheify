# Cacheify frontend env: what the UI build needs.
# Copy to .env.local for local runs; on Vercel, set the same keys in the
# project's Environment Variables.

# Origin of the backend API (Express in ../backend) — the frontend always
# calls the API origin, never itself (production UI is served from
# https://cacheify-redis-host.vercel.app).
NEXT_PUBLIC_API_URL=https://cacheify.bot-keep.xyz

# Public RESP gateway endpoint (host:port) for native-Redis-client connection
# strings shown in the dashboard and docs. Optional: until the gateway URL is
# set, the UI shows an obvious placeholder instead.
#NEXT_PUBLIC_GATEWAY_URL=<gateway-host>:<gateway-port>

# Local note: an empty NEXT_PUBLIC_API_URL means same-origin deployment
# (frontend and API served from one host) — runtime calls then use paths.
