# Cacheify RESP gateway configuration.
# Copy this file to `.env` (same folder) and fill in real values.
# Loaded automatically by the backend's dotenv loader when the gateway is
# started next to the backend; or export the variables into your service
# manager (pm2/Docker reads them from here).

# Where the Cacheify HTTPS data plane lives. REQUIRED for public/edge
# operation (per-connection AUTH routing goes through this API).
CACHEIFY_BASE_URL=http://127.0.0.1:34008

# Fixed Bearer API key for loopback/container mode (GATEWAY_BYPASS_AUTH=1).
# In public edge mode leave empty - each connection's AUTH password is a
# customer rk_ key. Never commit real keys.
CACHEIFY_API_KEY=

# Fallback database (rdb_...) for legacy/unscoped keys in edge mode, or the
# single target database in bypass mode. Leave empty when all keys are
# freshly scoped.
CACHEIFY_DB_ID=

# Optional extra SELECT registry for operator setups: SELECT index -> db id.
# Example: 0=rdb_abc123,1=rdb_def456
CACHEIFY_DB_MAP=

# Loopback-only container mode (fixed key, no AUTH needed). MUST stay off
# for anything reachable from outside the machine.
GATEWAY_BYPASS_AUTH=0

# Listen port. Note: 44141 is the sample Botkeep-assigned port here; use
# whichever raw-TCP port your panel assigns to the gateway process.
GATEWAY_PORT=44141

# 127.0.0.1 for local-only; 0.0.0.0 for public deployments behind a proxy.
GATEWAY_HOST=0.0.0.0

# TLS termination at the gateway itself. Set BOTH to PEM file paths to serve
# rediss:// clients; leave both unset (or commented) for plain redis://.
#GATEWAY_TLS_CERT=/etc/ssl/cacheify/fullchain.pem
#GATEWAY_TLS_KEY=/etc/ssl/cacheify/privkey.pem

# Upstream REST deadline per call (ms).
REST_TIMEOUT_MS=5000

# Global concurrent upstream REST calls.
MAX_REST_INFLIGHT=32

# Per-connection pipelined command queue cap.
MAX_QUEUE=256

# Total simultaneous client connections.
MAX_CONNECTIONS=2000

# Idle client socket reaper (ms).
GATEWAY_IDLE_TIMEOUT_MS=300000

# 1 = log every upstream call (method + path + status; never keys).
GATEWAY_DEBUG=0
